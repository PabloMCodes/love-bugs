# Export these in your shell; the standalone CLI does not automatically load .env.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
AGENT_MODEL=gemini-3.5-flash-lite
AGENT_INTERVAL_SECONDS=10
AGENT_TIMEOUT_SECONDS=20
# Backend autonomy is opt-in. Choose mock for deterministic local demos.
AUTONOMY_ENABLED=false
AUTONOMY_PROVIDER=mock
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# simulation (default) runs the movement loop; hardware waits for robot adapters.
GAME_MODE=simulation
# Optional validated game profile. Relative paths resolve from the directory where
# uvicorn is started. The committed demo profile is backend/game_config.json.
# GAME_CONFIG_PATH=./game_config.json
# Simulation defaults to seed 0 for repeatable demos. Set an integer explicitly
# to choose another sequence. Hardware uses system randomness when this is unset.
# FISHING_RANDOM_SEED=0
# Hardware reports must arrive faster than these freshness thresholds.
HEALTH_TIMEOUT_SECONDS=5
POSE_TIMEOUT_SECONDS=2
TELEMETRY_CHECK_INTERVAL_SECONDS=0.25
# Unanswered money requests and stage proposals expire so autonomy can replan.
ECONOMY_REQUEST_TIMEOUT_SECONDS=30

# Local persistence (default); export variables or explicitly use --env-file .env.
# Setup: python -m app.persistence init --env-file .env
# Verify: python -m app.persistence check --env-file .env
# Server: python -m uvicorn app.main:app --env-file .env
SQLITE_PATH=./lovebugs.sqlite3
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
